# Copy to .env (never commit .env)
APP_ENV=development
PORT=8000
DATABASE_URL=file:./tasks.db
# a user who registers with this email becomes an admin (Bonus 9); leave empty for none
ADMIN_EMAIL=
# must be changed in production (Bonus 11 refuses the default there)
JWT_SECRET=change-me
# Bonus 6: connections in the pool
DB_POOL_SIZE=4
# Bonus 14: when the purge job runs; "* * * * *" = every minute, to try it
PURGE_SCHEDULE=0 3 * * *
# Bonus 19: only for a hosted Turso database (DATABASE_URL=libsql://...)
DATABASE_AUTH_TOKEN=
