{
  "tasks": {
    "dev": "deno run -A --watch src/main.ts",
    "start": "deno run -A src/main.ts",
    "start:prod": "deno run -A --env-file=.env.production src/main.ts",
    "test": "deno test -A",
    "check": "deno check src/*.ts tests/*.ts scripts/*.ts drizzle.config.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "seed": "deno run -A scripts/seed.ts",
    "explain": "deno run -A scripts/explain.ts",
    "nplus1": "deno run -A scripts/n_plus_one.ts",
    "ui:install": "cd ui && deno install",
    "ui:dev": "cd ui && deno task dev",
    "db:generate": "deno run -A --node-modules-dir=auto --allow-scripts npm:drizzle-kit generate"
  },
  "unstable": [
    "kv",
    "cron"
  ],
  "imports": {
    "hono": "npm:hono@^4",
    "zod": "npm:zod@^4",
    "bcryptjs": "npm:bcryptjs@^3",
    "drizzle-orm": "npm:drizzle-orm@^0.44",
    "drizzle-orm/libsql": "npm:drizzle-orm@^0.44/libsql",
    "drizzle-orm/sqlite-core": "npm:drizzle-orm@^0.44/sqlite-core",
    "@libsql/client": "npm:@libsql/client@^0.15",
    "@std/assert": "jsr:@std/assert@^1",
    "drizzle-kit": "npm:drizzle-kit@^0.31",
    "drizzle-orm/libsql/migrator": "npm:drizzle-orm@^0.44/libsql/migrator",
    "jose": "npm:jose@^6",
    "@hono/zod-openapi": "npm:@hono/zod-openapi@^1",
    "@hono/swagger-ui": "npm:@hono/swagger-ui@^0.5"
  },
  "fmt": {
    "lineWidth": 90
  }
}
